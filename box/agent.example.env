# /etc/carplay-wan-agent.env
#
# Copy, edit, and keep it out of git. The SSID below carries the last five
# digits of your VIN, so this file is a secret even though it holds no password.

# Cars, as carplayd numbers them. LETTER=Name, or LETTER=Name=SSID in watch
# mode. Resolve cars by SSID, never by letter: the letter is an index into
# carplayd.conf and the two cars' letters are easy to transpose.
#
#   --car A=F32 --car B=F22
#
# Watch mode (no carplayd, no PSK, no association -- beacons only):
#
#   --car A=F32="BMW00000 CarPlay" --watch-dev cara --watch-interval 10
#
# MQTT instead of, or as well as, the HTTP endpoint:
#
#   --mqtt-host 10.0.0.5 --mqtt-user ha --mqtt-password '...'
#
# --reveal publishes real BSSIDs. Leave it off unless you are debugging your
# own garage, and never leave it on in a file you might share.

AGENT_ARGS=--car A=F32 --car B=F22 --listen 0.0.0.0:8099 --probe /usr/local/libexec/headunit_probe.py
